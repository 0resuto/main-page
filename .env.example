# PostgreSQL credentials for Docker Compose.
# POSTGRES_PASSWORD is required and embedded in the database URL, so use a
# strong URL-safe value (letters, digits, and -_.~).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-url-safe-password

# Public frontend values, inlined at Docker build time.
NEXT_PUBLIC_GITHUB_USERNAME=0resuto
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_PHONE_LINK=
NEXT_PUBLIC_EMAIL=
