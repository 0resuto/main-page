# URL to connect to the PostgreSQL database.
# When using Docker Compose, use the same password as POSTGRES_PASSWORD in the
# root .env. The host port is 5433; keep the password URL-safe.
ANALYTICS_DATABASE_URL=postgresql://postgres:change-me-to-a-strong-url-safe-password@localhost:5433/analytics_db

# Comma-separated list of allowed origins for CORS
ANALYTICS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Analytics retention in days (default 365, min 30, max 3650)
ANALYTICS_RETENTION_DAYS=365
