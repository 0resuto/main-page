# URL to connect to the PostgreSQL database
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analytics_db

# Comma-separated list of allowed origins for CORS
ANALYTICS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Analytics retention in days (default 365, min 30, max 3650)
ANALYTICS_RETENTION_DAYS=365
