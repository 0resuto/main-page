# ========================
# Глобальные исключения
# ========================
.DS_Store
*.pem
.env*
.env

# Логи пакетных менеджеров
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ========================
# Frontend (Next.js)
# ========================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/coverage/
frontend/next-env.d.ts

# Кэш TypeScript
*.tsbuildinfo

# Yarn (если используется)
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# ========================
# Backend (Python)
# ========================
backend/.venv/
backend/venv/
backend/env/

# Кэш и скомпилированные файлы Python
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd

# Тесты бэкенда (если появятся)
backend/.pytest_cache/
backend/coverage/
backend/.coverage